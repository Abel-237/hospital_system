# Django Settings
DEBUG=True
SECRET_KEY=change-this-in-production-use-a-strong-random-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# Cloudinary media storage (leave blank to keep local media storage in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database (PostgreSQL)
# Format: postgresql://user:password@localhost:5432/hospital_db
DATABASE_URL=sqlite:///db.sqlite3

# Cache & Celery (Redis)
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Internationalization & Location
TIME_ZONE=Africa/Douala
LANGUAGE_CODE=fr

# Orange Money Cameroon API Credentials
ORANGE_MONEY_ENV=sandbox
ORANGE_MONEY_CLIENT_ID=your_orange_money_client_id_here
ORANGE_MONEY_CLIENT_SECRET=your_orange_money_client_secret_here
ORANGE_MONEY_MERCHANT_KEY=your_merchant_key_here
ORANGE_MONEY_NOTIFICATION_URL=http://localhost:8000/billing/webhook/orange-money/

# MTN Mobile Money Cameroon API Credentials
MTN_MOMO_ENV=sandbox
MTN_MOMO_PRIMARY_KEY=your_mtn_subscription_primary_key_here
MTN_MOMO_API_USER=your_mtn_api_user_uuid_here
MTN_MOMO_API_KEY=your_mtn_api_key_here
MTN_MOMO_TARGET_ENVIRONMENT=sandbox

# Cameroon SMS Gateway (e.g. Orange SMS / Local Aggregator)
SMS_GATEWAY_URL=https://api.sms-gateway-cameroon.local/v1/messages
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=HOSPITAL_CMR

# Hospital Profile
HOSPITAL_NAME="Centre Hospitalier Universitaire Régional"
HOSPITAL_NAME_EN="Regional University Teaching Hospital"
HOSPITAL_PHONE="+237 670 000 000"
HOSPITAL_EMAIL="contact@hospital-cmr.local"
HOSPITAL_ADDRESS="Douala / Yaoundé, Cameroun"
